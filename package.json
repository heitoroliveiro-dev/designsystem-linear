{
  "name": "designsystem-linear",
  "version": "1.0.0",
  "private": true,
  "description": "Design system dark-first inspirado na linguagem visual do Linear. Tokens DTCG, Tailwind v4, Radix e componentes no padrão shadcn/ui.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run tokens && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/generate-scales.mjs && node scripts/build-tokens.mjs",
    "tokens:check": "npm run tokens && git diff --exit-code -- tokens src/styles/tokens.css",
    "check": "npm run tokens && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.57.0",
    "next": "^16.4.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "^16.4.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3"
  }
}
